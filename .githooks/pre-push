#!/usr/bin/env bash
# pre-push：差异门控 + 待推送 Git 快照的默认五输出并行求值。
# SHA 来自 stdin 协议，不能用当前 HEAD/工作树/本机 local 选配替代。
# 多 ref 逐个检查、同一 commit 去重；任一失败拦 push。只求值，不构建。
# EVAL_SKIP_RE 仅列确定不进五输出的路径，清单外一律检查；tests/prepush-gate.sh
# 审计该清单与 Nix 引用不交叉。机制与历史见 docs/roam.md、.github/SYNC.md。
# 启用：git config core.hooksPath .githooks；单次绕过：git push --no-verify。
set -euo pipefail

# 差异门控（tests/prepush-gate.sh source 本文件后打桩 git 单测此函数；主段经
# BASH_SOURCE 守卫跳过，与 roam.sh 的分发守卫同款）。读 pre-push stdin（每行
# <local_ref> <local_sha> <remote_ref> <remote_sha>），任一 ref 的远端→本地
# 端点差异碰到求值输入 → 返回 0（须检查）。放行：删除推送（local 全零）无新
# 提交落库；diff 本身失败（remote sha 本地缺失等）与新分支（remote 全零，无
# 基线可比）不属此类——一律保守跑全量，方向上宁多跑勿漏跑。
EVAL_SKIP_RE='^(\.github|\.githooks|bootstrap|docs|tests)/|^(README\.md|AGENTS\.md|LICENSE|\.gitignore)$'
gate_needed() {
  local _ local_sha remote_sha diff_out
  while read -r _ local_sha _ remote_sha; do
    case "$local_sha" in
      *[!0]*) ;;
      *) continue ;; # 全零 = 删远端引用，无新提交落库
    esac
    case "$remote_sha" in
      *[!0]*)
        diff_out="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)" || return 0
        # 清单外任一文件 = 潜在求值输入 → 拦下。here-string 而非 printf|grep 管道：
        # grep -q 命中即退会让管道对端吃 SIGPIPE，pipefail 下整管道判假——恰好落在
        # 漏放行方向。空差异显式排除：here-string 对空串产生一个空行，-v 会把它
        # 当「未命中清单」误判为输入。
        if [ -n "$diff_out" ] && grep -qEv "$EVAL_SKIP_RE" <<<"$diff_out"; then
          return 0
        fi
        ;; # 该 ref 增量全为清单内非输入——继续看下一个 ref
      *)
        return 0 # 新分支无基线可比，保守跑全量
        ;;
    esac
  done
  return 1
}

# 全部消费 stdin，保留每个需要检查的 commit；annotated tag 先 peel 再去重。
eval_revisions() {
  local local_ref local_sha remote_ref remote_sha rev seen='' rc=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    if gate_needed <<<"$local_ref $local_sha $remote_ref $remote_sha"; then
      rev="$(git rev-parse --verify "${local_sha}^{commit}")" || {
        printf 'pre-push: 无法读取待推送提交 %s（%s）\n' "$local_sha" "$local_ref" >&2
        rc=1
        continue
      }
      case " $seen " in
        *" $rev "*) continue ;;
      esac
      seen="$seen $rev"
      printf '%s\n' "$rev"
    fi
  done
  return "$rc"
}

# 使用 Git fetcher 的锁定 rev；allRefs 允许检查非 HEAD 分支/标签。
# URL 中的路径分隔符保留，其余 URI 特殊字符编码（支持空格路径）。
snapshot_ref() {
  local root="$1"
  root="${root//%/%25}"
  root="${root// /%20}"
  root="${root//\?/%3F}"
  root="${root//#/%23}"
  printf 'git+file://%s?rev=%s&allRefs=1' "$root" "$2"
}

check_revision() (
  local ref tmp attr i=0 rc=0 pid
  local attrs=(
    nixosConfigurations.nixos.config.system.build.toplevel
    nixosConfigurations.wsl.config.system.build.toplevel
    homeConfigurations.x86_64-linux.activationPackage
    homeConfigurations.aarch64-linux.activationPackage
    homeConfigurations.aarch64-darwin.activationPackage
  )
  local pids=()
  ref="$(snapshot_ref "$1" "$2")"
  tmp="$(mktemp -d)" || return 1
  trap 'rm -rf "$tmp"' EXIT
  # nix 进程直接后台运行，信号时可终止并等待所有子进程再清理日志。
  trap 'for pid in ${pids[*]:-}; do kill "$pid" 2>/dev/null || true; done; wait; exit 130' INT
  trap 'for pid in ${pids[*]:-}; do kill "$pid" 2>/dev/null || true; done; wait; exit 143' TERM
  printf 'pre-push: 检查待推送提交 %s（默认五输出，并行求值）\n' "$2"
  for attr in "${attrs[@]}"; do
    nix eval --raw "$ref#${attr}.drvPath" >"$tmp/$i.out" 2>"$tmp/$i.err" &
    pids+=("$!")
    i=$((i + 1))
  done
  i=0
  for attr in "${attrs[@]}"; do
    if wait "${pids[$i]}"; then :; else rc=1; fi
    printf 'pre-push: 求值 %s\n' "$attr"
    cat "$tmp/$i.out"
    if [ -s "$tmp/$i.out" ]; then printf '\n'; fi
    cat "$tmp/$i.err" >&2
    i=$((i + 1))
  done
  if [ "$rc" -eq 0 ]; then
    printf 'pre-push: 提交 %s 默认五输出全部通过\n' "$2"
  else
    printf 'pre-push: 提交 %s 存在失败输出\n' "$2" >&2
  fi
  return "$rc"
)

pre_push() {
  local root revisions rev rc=0
  root="$(git rev-parse --show-toplevel)" || return 1
  if revisions="$(eval_revisions)"; then :; else rc=1; fi
  if [ -z "$revisions" ]; then
    [ "$rc" -eq 0 ] || return "$rc"
    printf 'pre-push: 推送增量全部为已知非求值输入或删除/空差异，跳过五输出求值\n'
    return 0
  fi
  printf 'pre-push: 本机选配与未提交修改不进入推送验证；本机环境另用 roam check 验证\n'
  # revisions 是 Git 返回的 commit SHA 行列表，无空格或 glob。
  # shellcheck disable=SC2086
  for rev in $revisions; do
    check_revision "$root" "$rev" || rc=1
  done
  return "$rc"
}

# 执行守卫：被 source 时不执行（tests/ 加载函数）
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  pre_push
fi
